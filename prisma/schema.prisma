generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Etudiant {
  id              Int      @id @default(autoincrement())
  nomEtudiant     String
  prenomEtudiant  String
  ageEtudiant     Int
  filiereEtudiant String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
